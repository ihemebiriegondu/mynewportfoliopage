rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
